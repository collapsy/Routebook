{
  "name": "routebook",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.17.0 <12"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm docs:validate && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:migrate": "pnpm --filter @routebook/database db:migrate",
    "db:migration-status": "pnpm --filter @routebook/database db:migration-status",
    "dev": "turbo run dev",
    "docs:validate": "node scripts/validate-docs.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "materialize:place-images": "node scripts/materialize-place-images.mjs --materialize",
    "promote:place-candidates": "pnpm --filter @routebook/database exec tsx ../../scripts/promote-place-candidates.mjs",
    "smoke:operational": "node scripts/operational-smoke.mjs",
    "test": "turbo run test && pnpm test:place-quality-provider-spike",
    "test:operational-smoke": "node --test scripts/operational-smoke.test.mjs",
    "test:overture-place-normalizer": "node --test scripts/normalize-overture-places.test.mjs",
    "test:place-images": "node --test scripts/materialize-place-images.test.mjs && node scripts/materialize-place-images.mjs --verify",
    "test:production-deployment-verification": "node --test scripts/verify-production-deployment.test.mjs",
    "test:release-migration-policy": "node --test scripts/release-migration-policy.test.mjs",
    "test:vercel-staged-deployment": "node --test scripts/verify-vercel-staged-deployment.test.mjs",
    "test:e2e": "pnpm --filter @routebook/web test:e2e",
    "typecheck": "turbo run typecheck",
    "spike:place-quality-providers": "node scripts/compare-place-quality-providers.mjs",
    "test:place-quality-provider-spike": "node --test scripts/compare-place-quality-providers.test.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "2.10.7"
  }
}
