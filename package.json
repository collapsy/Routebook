{
  "name": "routebook",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.17.0 <12"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm docs:validate && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:migrate": "pnpm --filter @routebook/database db:migrate",
    "dev": "turbo run dev",
    "docs:validate": "node scripts/validate-docs.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --write packages/database/src/apply-itinerary-proposal-transaction.test.ts packages/database/src/apply-itinerary-proposal-transaction-postgres.test.ts && git diff -- packages/database/src/apply-itinerary-proposal-transaction.test.ts packages/database/src/apply-itinerary-proposal-transaction-postgres.test.ts && exit 1",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @routebook/web test:e2e",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "2.10.7"
  }
}
