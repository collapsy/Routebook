DATABASE_URL=postgresql://routebook:routebook@127.0.0.1:5432/routebook
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Destination resolution is disabled until a Provider is deliberately enabled.
ROUTEBOOK_DESTINATION_RESOLVER=
ROUTEBOOK_DESTINATION_SUGGESTION_PROVIDER=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
ROUTEBOOK_NOMINATIM_USER_AGENT=RouteBook/0.1 (+https://github.com/collapsy/Routebook)

# Google Places credentials are server-side only and require an explicit environment gate.
GOOGLE_PLACES_API_KEY=

# Place bootstrap defaults are safe and can be reduced/disabled without enabling new Providers.
ROUTEBOOK_PLACE_DISCOVERY_ENABLED=true
ROUTEBOOK_PLACE_DISCOVERY_MAX_ATTEMPTS=2
ROUTEBOOK_PLACE_QUALITY_ENABLED=true
ROUTEBOOK_PLACE_QUALITY_MAX_ATTEMPTS=2
ROUTEBOOK_PLACE_QUALITY_TARGET_LIMIT=60
ROUTEBOOK_PLACE_MEDIA_ENABLED=true
ROUTEBOOK_PLACE_MEDIA_MAX_ATTEMPTS=2
ROUTEBOOK_PLACE_MEDIA_PREVIEW_BUDGET=12
